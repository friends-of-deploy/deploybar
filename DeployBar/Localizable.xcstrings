{
  "sourceLanguage" : "en",
  "strings" : {
    "Share crash reports": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępniaj raporty awarii"
          }
        }
      }
    },
    "Help us fix problems by sending technical crash reports to Sentry.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomóż nam usuwać problemy, wysyłając techniczne raporty awarii do Sentry."
          }
        }
      }
    },
    "What is shared?": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakie dane są udostępniane?"
          }
        }
      }
    },
    "Crash report privacy": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prywatność raportów awarii"
          }
        }
      }
    },
    "Privacy": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prywatność"
          }
        }
      }
    },
    "Reports include crash stack traces, app and macOS versions, and basic hardware information.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raporty zawierają stos wywołań z chwili awarii, wersje aplikacji i macOS oraz podstawowe informacje o sprzęcie."
          }
        }
      }
    },
    "We exclude account details, tokens, repository names, deployment URLs, build logs, and usage statistics.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wysyłamy danych kont, tokenów, nazw repozytoriów, adresów wdrożeń, logów kompilacji ani statystyk użycia."
          }
        }
      }
    },
    "Reporting is optional. Turning it off stops reporting and deletes pending reports from this Mac. Reports already sent remain in Sentry.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raportowanie jest opcjonalne. Wyłączenie zatrzymuje raportowanie i usuwa oczekujące raporty z tego Maca. Wysłane raporty pozostają w Sentry."
          }
        }
      }
    },
    "On notification click": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po kliknięciu powiadomienia"
          }
        }
      }
    },
    "Open site (if available)": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz stronę (jeśli dostępna)"
          }
        }
      }
    },
    "If the site URL is unavailable, opens the deployment instead.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli adres strony jest niedostępny, otworzy szczegóły wdrożenia."
          }
        }
      }
    },
    "Mute...": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wycisz..."
          }
        }
      }
    },
    "Mute this kind": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wycisz ten rodzaj"
          }
        }
      }
    },
    "Mute this project": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wycisz ten projekt"
          }
        }
      }
    },
    "DeployBar looks for your Vercel and GitHub CLI logins when it starts." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeployBar wykrywa konta zalogowane w CLI Vercela i GitHuba podczas uruchamiania."
          }
        }
      }
    },
    "We found your accounts. You’re ready to follow their deployments." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znaleźliśmy Twoje konta. Możesz już obserwować ich wdrożenia."
          }
        }
      }
    },
    "You can add or remove providers any time in the app settings:" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz dodawać i usuwać dostawców w dowolnej chwili w ustawieniach aplikacji:"
          }
        }
      }
    },
    "Account Settings…" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienia kont…"
          }
        }
      }
    },
    "Sign in with vercel login, then restart DeployBar." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaloguj się przez vercel login i uruchom DeployBar ponownie."
          }
        }
      }
    },
    "Sign in with gh auth login, then restart DeployBar." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaloguj się przez gh auth login i uruchom DeployBar ponownie."
          }
        }
      }
    },
    "%lld accounts available" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostępne konta: %lld"
