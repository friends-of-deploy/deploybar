      }
    },
    "Straight to what matters" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od razu do rzeczy"
          }
        }
      }
    },
    "Open a deployment or copy an error without digging through tabs." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
