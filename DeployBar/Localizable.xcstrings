        }
      }
    },
    "Stay in your flow" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pracuj bez rozpraszania"
          }
        }
      }
    },
    "Know when a build succeeds or needs your attention." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dowiedz się, kiedy build się uda lub wymaga Twojej uwagi."
