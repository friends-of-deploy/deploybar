    },
    "Not detected" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie wykryto"
          }
        }
      }
    },
    "Close window" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamknij okno"
          }
        }
      }
    },
    "Your followed projects will appear here. Manage your accounts to choose what to follow." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutaj pojawią się obserwowane projekty. Wybierz je w ustawieniach kont."
          }
        }
      }
    },
    "New activity from your followed projects will appear here." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutaj pojawi się nowa aktywność w obserwowanych projektach."
          }
        }
      }
    },
    "Welcome to DeployBar" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Witaj w DeployBar"
          }
        }
      }
    },
    "%lld of 3" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld z 3"
          }
        }
      }
    },
    "Step %lld of 3" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krok %lld z 3"
          }
        }
      }
    },
    "Your deployments.\nA glance away." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje wdrożenia.\nZawsze pod ręką."
          }
        }
      }
    },
    "A little less tab switching. A lot more peace of mind." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mniej przełączania kart. Więcej spokoju."
          }
        }
      }
    },
    "Everything in one place" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko w jednym miejscu"
          }
        }
      }
    },
    "All your project deployments in your menu bar." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie wdrożenia Twoich projektów na pasku menu."
